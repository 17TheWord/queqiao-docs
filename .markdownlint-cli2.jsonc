{
  "globs": ["README.md", "docs/**/*.md"],
  "ignores": ["docs/.vuepress/**", "node_modules/**"],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false,
    "MD034": false,
    "MD041": false,
    "MD046": {
